# ===== Obrigatório =====
DISCORD_TOKEN=cole_o_token_do_bot_aqui
# ID do servidor do Discord (clique direito no servidor > Copiar ID)
GUILD_ID=1566773079806574604

# ===== Coleta de comentários =====
# YouTube Data API v3 (Google Cloud Console)
YOUTUBE_API_KEY=
# Apify (apify.com > Settings > Integrations > API token)
APIFY_TOKEN=

# Actors da Apify (só mude se for usar outros)
APIFY_IG_COMMENTS_ACTOR=apify~instagram-comment-scraper
APIFY_IG_PROFILE_ACTOR=apify~instagram-profile-scraper
APIFY_TT_COMMENTS_ACTOR=clockworks~tiktok-comments-scraper
APIFY_TT_PROFILE_ACTOR=clockworks~tiktok-profile-scraper
APIFY_IG_FOLLOWING_ACTOR=coderx~instagram-followers-following-scraper-no-cookies-login
APIFY_TT_FOLLOWING_ACTOR=coregent~tiktok-followers-following-scraper

# ===== Regras da comunidade =====
# Janela móvel (dias) usada no índice de participação
WINDOW_DAYS=30
# Mínimo de comentários dados na janela para sair da faixa 1-3
MIN_ACTIVITY=5
# Razão dados/recebidos que corresponde ao nível 10
TARGET_RATIO=1.0
# Publicações por membro a cada 7 dias
POSTS_PER_WEEK=1
# Horas após a publicação em que a coleta acontece
COLLECT_CHECKPOINTS_HOURS=24,72,168
# Recrutados ativos necessários para ganhar o cargo de Divulgador
RECRUITER_MIN_ACTIVE=3

# Banco de dados: string de conexão do Supabase (Session pooler, porta 5432).
# Deixe vazio para usar um arquivo SQLite local (backline.db).
DATABASE_URL=

# ===== Mutual Follow =====
# Quantos perfis recentes do "seguindo" ler em cada verificação (Instagram/TikTok)
MUTUAL_SCAN_LIMIT=100
# Tentativas antes de marcar um follow como não encontrado
MUTUAL_MAX_ATTEMPTS=3
